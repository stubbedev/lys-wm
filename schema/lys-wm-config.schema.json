{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stubbedev/lys-wm/blob/main/schema/lys-wm-config.schema.json",
  "type": "object",
  "properties": {
    "animations": {
      "type": "object",
      "properties": {
        "curves": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "bezier": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "spring": {
                "type": "object",
                "properties": {
                  "damping": {
                    "type": "number"
                  },
                  "mass": {
                    "type": "number"
                  },
                  "stiffness": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "events": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "curve": {
                "type": "string"
              },
              "duration": {
                "type": "integer"
              },
              "enabled": {
                "type": "boolean"
              },
              "style": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "reduced_motion": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "autostart": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "autotile": {
      "type": "object",
      "properties": {
        "divisor": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "ephemeral": {
          "type": "boolean",
          "default": true
        },
        "min_trigger": {
          "type": "integer",
          "minimum": 0,
          "default": 400
        }
      },
      "additionalProperties": false
    },
    "binds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "chord": {
            "type": "string"
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "locked",
                "repeating"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "borders": {
      "type": "object",
      "properties": {
        "active": {
          "default": "accent",
          "oneOf": [
            {
              "type": "string",
              "format": "lys-wm-color"
            },
            {
              "type": "object",
              "properties": {
                "angle": {
                  "type": "number"
                },
                "colors": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 10,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "inactive": {
          "default": "#ffffff14",
          "oneOf": [
            {
              "type": "string",
              "format": "lys-wm-color"
            },
            {
              "type": "object",
              "properties": {
                "angle": {
                  "type": "number"
                },
                "colors": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 10,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "default": 1
