#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:

override_dh_dwz:

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_auto_install:
	install -d debian/lys-wm/usr/bin
	install -m 0755 lys-wm lys-wmctl debian/lys-wm/usr/bin/

	install -D -m 0644 lys-wm-session.target debian/lys-wm/usr/lib/systemd/user/lys-wm-session.target
	install -D -m 0644 lys-wm-portals.conf debian/lys-wm/usr/share/xdg-desktop-portal/lys-wm-portals.conf
	install -D -m 0644 lys-wm.desktop debian/lys-wm/usr/share/wayland-sessions/lys-wm.desktop

	install -d debian/lys-wm/usr/share/lys-wm
	ln -s ../fonts/truetype/dejavu/DejaVuSans.ttf debian/lys-wm/usr/share/lys-wm/DejaVuSans.ttf

	install -D -m 0644 THIRD_PARTY.md debian/lys-wm/usr/share/doc/lys-wm/THIRD_PARTY.md
