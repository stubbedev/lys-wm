    "input": {
      "type": "object",
      "properties": {
        "devices": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "accel_profile": {
                "type": "string",
                "enum": [
                  "adaptive",
                  "flat"
                ]
              },
              "accel_speed": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "click_method": {
                "type": "string",
                "enum": [
                  "button_areas",
                  "clickfinger",
                  "none"
                ]
              },
              "disable_while_typing": {
                "type": "boolean"
              },
              "drag_lock": {
                "type": "boolean"
              },
              "middle_emulation": {
                "type": "boolean"
              },
              "natural_scroll": {
                "type": "boolean"
              },
              "scroll_factor": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "scroll_method": {
                "type": "string",
                "enum": [
                  "edge",
                  "none",
                  "on_button_down",
                  "two_finger"
                ]
              },
              "tap": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "keyboard": {
          "type": "object",
          "properties": {
            "layout": {
              "type": "string",
              "format": "lys-wm-xkb-layout"
            },
            "model": {
              "type": "string",
              "format": "lys-wm-xkb-model"
            },
            "options": {
              "type": "string",
              "format": "lys-wm-xkb-options"
            },
            "repeat_delay": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647,
              "default": 300
            },
            "repeat_rate": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647,
              "default": 50
            },
            "rules": {
              "type": "string",
              "format": "lys-wm-xkb-rules"
            },
            "slow_keys": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647,
              "default": 0
            },
            "sticky_keys": {
              "type": "boolean",
              "default": false
            },
            "variant": {
              "type": "string",
              "format": "lys-wm-xkb-variant"
            }
          },
          "additionalProperties": false
