        "pointer": {
          "type": "object",
          "properties": {
            "accel_profile": {
              "type": "string",
              "enum": [
                "adaptive",
                "flat"
              ]
            },
            "accel_speed": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "click_method": {
              "type": "string",
              "enum": [
                "button_areas",
                "clickfinger",
                "none"
              ]
            },
            "disable_while_typing": {
              "type": "boolean"
            },
            "drag_lock": {
              "type": "boolean"
            },
            "middle_emulation": {
              "type": "boolean"
            },
            "natural_scroll": {
              "type": "boolean"
            },
            "scroll_factor": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "scroll_method": {
              "type": "string",
              "enum": [
                "edge",
                "none",
                "on_button_down",
                "two_finger"
              ]
            },
            "tap": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "touchpad": {
          "type": "object",
          "properties": {
            "accel_profile": {
              "type": "string",
              "enum": [
                "adaptive",
                "flat"
              ]
            },
            "accel_speed": {
              "type": "number",
              "minimum": -1,
              "maximum": 1
            },
            "click_method": {
              "type": "string",
              "enum": [
                "button_areas",
                "clickfinger",
                "none"
              ]
            },
            "disable_while_typing": {
              "type": "boolean"
            },
            "drag_lock": {
              "type": "boolean"
            },
            "middle_emulation": {
              "type": "boolean"
            },
            "natural_scroll": {
              "type": "boolean"
            },
            "scroll_factor": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "scroll_method": {
              "type": "string",
              "enum": [
                "edge",
                "none",
                "on_button_down",
                "two_finger"
              ]
            },
            "tap": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
