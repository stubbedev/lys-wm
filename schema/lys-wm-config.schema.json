      },
      "additionalProperties": false
    },
    "client_hotkeys": {
      "type": "boolean",
      "default": false
    },
    "color_management": {
      "type": "boolean",
      "default": false
    },
    "decoration": {
      "type": "object",
      "properties": {
        "active_opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
