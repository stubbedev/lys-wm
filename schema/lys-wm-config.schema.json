        "outer": {
          "default": 8,
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "gestures": {
      "type": "object",
      "properties": {
        "distance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 400
