        "hold": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string"
              },
              "direction": {
                "type": "string"
              },
              "drive": {
                "type": "string"
              },
              "fingers": {
                "type": "integer"
              },
              "modifiers": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "pinch": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string"
              },
              "direction": {
                "type": "string"
              },
              "drive": {
                "type": "string"
              },
              "fingers": {
                "type": "integer"
              },
              "modifiers": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "swipe": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string"
              },
              "direction": {
                "type": "string"
              },
              "drive": {
                "type": "string"
              },
              "fingers": {
                "type": "integer"
              },
              "modifiers": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
