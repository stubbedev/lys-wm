        "blur": {
          "type": "object",
          "properties": {
            "brightness": {
              "type": "number",
              "minimum": 0,
              "maximum": 4,
              "default": 1
            },
            "contrast": {
              "type": "number",
              "minimum": 0,
              "maximum": 4,
              "default": 1
            },
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "grain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0
            },
            "layers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "live_tiled": {
              "type": "boolean",
              "default": false
            },
            "mica": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "passes": {
                  "type": "integer"
                },
                "size": {
                  "type": "integer"
                },
                "tint": {
                  "type": "string",
                  "format": "lys-wm-color"
                }
              },
              "additionalProperties": false
            },
            "passes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "default": 2
            },
            "refraction": {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "integer"
                },
                "bezel": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            },
            "saturation": {
              "type": "number",
              "minimum": 0,
              "maximum": 4,
              "default": 1.3
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "default": 6
            },
            "specular": {
              "type": "object",
              "properties": {
                "strength": {
                  "type": "number"
                },
                "width": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            },
            "tint": {
              "type": "string",
              "format": "lys-wm-color"
            },
            "xray": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false
        },
        "dim_inactive": {
          "type": "boolean",
          "default": false
        },
        "dim_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "fullscreen_opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "inactive_opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "rounding": {
          "type": "integer",
          "minimum": 0,
          "default": 8
        },
        "shadow": {
          "type": "object",
          "properties": {
            "color": {
              "type": "string",
              "format": "lys-wm-color",
              "default": "#00000060"
            },
            "color_inactive": {
              "type": "string",
              "format": "lys-wm-color",
              "default": "#00000038"
            },
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "offset": {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              ]
            },
            "range": {
              "type": "integer",
              "minimum": 0,
              "default": 24
            },
            "render_power": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4,
              "default": 2
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1,
              "default": 1
            },
            "sharp": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "drag_preview": {
      "type": "object",
      "properties": {
        "blur": {
          "type": "boolean",
          "default": false
